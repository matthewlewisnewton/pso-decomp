  "historical_rows_closed": {
    "2260": "Frame model construction, texture load and texture and model teardown use the BmlResource and Ginja texture-list pointers. The native calls cover 0x801FB8AC and 0x801FB904.",
    "2515": "The header declares the live scissor rectangle, single view mode, projection record, const delay and model pointer returns. The recovered draw_compass method uses the existing name.",
    "2531": "The original model accessor at 0x801FB9A4 returns NJS_OBJECT * and accepts the read-only delay. The resource is owned as a BmlResource pointer.",
    "2601": "The loading cursor uses a typed three-word rotation block at 0x804349FC, reads the shared camera direction and position, and retains the two verified sound calls and existing class-name string.",
    "2614": "The native radar constructor stores the three typed model pointers and initializes all three 0x28 view records with the original position, direction and rotation fields.",
    "2615": "The resource loader retains the original r.rel suffix and shared texture loader. The compass method at 0x801FB874 accepts the read-only delay and uses the native texture-list setter with its upstream name."
  },
  "historical_rows_with_added_evidence": {
    "424": "The shared camera-vector transform declaration takes a source and destination Vec pointer",
    "842": "The camera transform at 0x8007E884 uses typed Vec arguments with the original name and owner",
    "951": "The tunnel effect reads the same typed camera direction as De Rol Le and the renderer",
    "956": "The ambient effect callers pass the shared camera record and their native Vec pointers",
    "1116": "The Saver transform shares the camera record and original native vector interface",
    "1125": "The tunnel effect direction comes from the shared camera record",
    "2602": "The radar composes three typed view records with shared scissor, projection, sprite and region model interfaces",
    "4896": "The world camera storage is the same 0x28 type as the radar view, with typed position, direction and initialization",
    "4962": "The scripted projection writes the existing camera position fields through the shared record",
    "5087": "The lobby stores its sprite and all three frames in their native types and calls the shared sprite owner",
    "6950": "The Grass camera-vector calculations use the confirmed shared camera record and typed vector inputs"
  },
