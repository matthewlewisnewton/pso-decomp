  "partially_reconciled_rows": [
    {
      "row": 794,
      "path": "src/pso/boss/darkfalz/TBoss4DarkFalz_8004C93C.cpp",
      "current_blob": "48ccd205b4c04851be8068b5e4fbf7bdba26d05b",
      "scope": "The three phase factories now receive the native 0x44-byte spawn record. The controller also passes the real scene to the phase-two ring setup and uses its native collision push method. Other scene and cinematic helpers remain under review. The broader historical row is still open."
    },
    {
      "row": 913,
      "path": "src/pso/boss/darkfalz/TBoss4Type1.cpp",
      "current_blob": "e08eefcefd31622ab2c90b2f8bf9390ec7b5534e",
      "scope": "The first form uses typed rows for animation modes, transitions and model slots. Timing reads and writes native fields, and part drawing uses its live capture data. Other first-form and collider changes remain under review. The broader historical row is still open."
    },
    {
      "row": 944,
      "path": "src/pso/boss/darkfalz/TObjDFHorming.cpp",
      "current_blob": "cf1c1fdbada6264e41b94e1cc398f3d4f52f5d35",
      "scope": "Both outbound paths and the receiver share the actual 16-byte packet. Arena collision reads the player position and collision-body flags through the existing owners. Other controller initialization and helper changes remain under review. The broader historical row is still open."
    },
    {
      "row": 1069,
      "path": "src/pso/boss/darkfalz/TObjDFJisin.cpp",
      "current_blob": "9e192710e75f33a4d8e685c0ea031bea44488abb",
      "scope": "The recover ball and fire ring access their native fields and emitters. The fire ring uses the original player and direct-attack interfaces. The wider Homing, Tenchu and tower changes remain under review. The broader historical row is still open."
    },
    {
      "row": 1139,
      "path": "src/pso/boss/darkfalz/TBoss4Zanzo.cpp",
      "current_blob": "e129fe3edfc9bc00085dffb0d431862d69df33b7",
      "scope": "The second form reads typed animation rows in its own timer, model drawing and afterimage copy paths. The afterimage carries real model, texture and motion pointers. Other phase-two callbacks remain under review. The broader historical row is still open."
    },
    {
      "row": 1149,
      "path": "src/pso/boss/darkfalz/TBoss4Type3.cpp",
      "current_blob": "824e124558d85aa194b9ec6ec306f2ce4e1663ca",
      "scope": "The third form creates and destroys native helpers and samples its animation nodes using the typed table and model. Other third-form state behavior remains under review. The broader historical row is still open."
    }
  ],
