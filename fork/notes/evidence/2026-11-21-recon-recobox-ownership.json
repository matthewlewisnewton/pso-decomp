  "source_fixes": [
    "Recobox owns the child-state handlers, tracked IDs, spawn timer, counts and shared floor contact.",
    "Recon and Recobox use their native opacity fades. Recobox uses four camera render fades, and Recon writes the actual position of its movement emitter.",
    "Recon and ReconBomb use a shared BmlResource pointer. Archive setup uses the native model and motion records, and Recon stores the typed parent ID.",
    "The enemy proximity-flag helper declares the void return it implements, under its existing name."
  ],
  "code_generation_decisions": [
    "The factory and its constructor share the original unsigned halfword ID argument.",
    "The Recobox constructor keeps its existing BML offset expressions for the model, texture and motion setup. Replacing those three expressions changed register allocation. Archive load, lookup and release use the shared BML type."
  ],
  "historical_rows_closed": {
    "681": {
      "historical_path": "include/pso/enemy/TUnk_80493450.h",
      "owner": "include/pso/enemy/TUnk_80493450.h",
      "owner_blob": "e2c0047a3c48555aee7c2e2fb7dad91410fa3769",
      "decision": "The prototype and definition use void because no caller consumes a result and the implementation returns none. Keep upstream's existing sub_800C4E08 name."
    },
    "749": {
      "historical_path": "include/pso/enemy/TObjEneMe3ShinowaReal.h",
      "owner": "include/pso/enemy/shinowa/TObjEneMe3ShinowaReal.h",
      "owner_blob": "0c0b8c02778892184c9247e96b18e504e33a2865",
      "decision": "The current upstream header already has the native constructor, the four u16 mirage IDs at +0x42C, and the accurate pointer return from get_or_create_mirage. Keep upstream's m_42c field name and pointer return."
    }
  },
  "historical_rows_with_added_evidence": {
    "621": "Recon uses the native parent ID at +0x434 and calls the Recobox child handling methods through the actual parent receiver.",
    "629": "Recon initializes its native fade and particle emitter fields, tests the Recobox parent's mode, and allocates children through the shared typed factory. Actor stat and motion contracts still need comparison.",
    "1115": "Recobox uses the embedded opacity fade and four render fades. The BML resource and its model and motion lists have typed owners. These source changes preserve the retail setup, action dispatch and teardown instructions. The historical typed combat stat and motion contracts still need comparison."
  },
