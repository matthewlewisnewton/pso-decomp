  "historical_rows_closed": {
    "798": "The fade owns its packed quad colors and typed fullscreen vertices. The fade scale of 255 and draw depth of -1 are represented by the original matched float pools.",
    "2526": "The movement effect uses the typed 2D descriptor and the shared four-byte color copy. The native constructor and its source-owned tables retain the original fields and the 1e-05 and -1.01 draw constants.",
    "2742": "The quest panels and letterbox bars use the shared typed descriptor with their original -490 draw depth. The border helper retains the original -500 depth and all six float constants.",
    "4353": "The implementation remains at the active loader owner. free_data_file and node teardown use safe_free, and load_data_file uses load_disc_file, the linked address 0x800F9D38 used by the fork wrapper.",
    "4971": "The native graph has the progress and packed bar colors with the 0x64 class layout. draw_progress_bar takes typed position and size references at the fork wrapper address 0x8007F27C. Its C++ destructor is declared.",
    "5846": "The color swap is declared and implemented on ColorLineList. The TWindowCtrlMain declaration is gone and its controller callers use the shared primitive."
  },
  "historical_rows_with_added_evidence": {
    "230": "The keyboard draw helpers use the shared packed-color list for all glyph quads",
    "262": "The balloon tail uses the shared three-vertex descriptor and matches its original depth",
    "268": "The soft keyboard uses the shared color line declaration and native descriptor",
    "763": "The full-screen warp uses the typed quad and a writable packed-color array at the retail data address",
    "2397": "The character layout uses the typed footer, hair color and proportion primitives",
    "2602": "The radar backdrop now draws a native ColorLineList through the upstream polygon entry point",
    "5107": "Both 2D drawing functions use the actual color-list type and the strip swap is a native method",
    "5521": "The split-screen status dividers use the same typed quad and packed colors",
    "5533": "The menu backdrop, screen quad and guideline all use the shared descriptor",
    "5651": "The backdrop and packed color data use the native rectangle descriptor",
    "5680": "The quest board selector uses the shared descriptor and C declaration for its guide line",
    "5760": "The gauge color copy uses a shared byte-copy interface for all four channels at 0x80257720",
    "5829": "The card row guide line uses the native ColorLineList and the shared declaration",
    "6012": "Both fade renderers use the typed descriptor with their original color and depth"
  },
