  "historical_rows_closed": {
    "763": "The existing EmptyWarp name, 640-by-480 quad and mutable colors are preserved. The camera exit uses its native call, and both tube state writes are on the Tube receiver at their original addresses. The live sound declaration is shared."
  },
  "historical_rows_with_added_evidence": {
    "520": "The phase clock uses the native signed field, and the phase-two query uses the real boss instance without a pointer cast",
    "521": "Type 1 now constructs through TObjEnemy and TObjControl, passes the typed spawn record, uses the plot receiver, and initializes its native position, motion, collision and capture state",
    "738": "The Type 1 constructor and factory now share the actual spawn record. The owner, history, flags and initial position writes have native storage",
    "754": "The native 0x384 Tube pointer and signed point cursor at 0x3C8 are asserted at their original offsets",
    "906": "Phase spawning now uses one typed plot owner and set entry, and position reads and lifecycle calls target the active Type 1 and Type 2 receivers. The tube and point cursor use native Plot storage",
    "1051": "The Mag Mine phase lookup uses the real Type 2 pointer and preserves the original linked getter and call site",
    "1064": "Phase 2 construction and its factory share the same typed plot owner and set entry as Phase 1",
    "1076": "The constructor uses the real plot owner and signed variant byte from the shared set entry, with unchanged flag and segment initialization"
  },
